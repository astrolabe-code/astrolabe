{
  "name": "astrolabe-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "Astrolabe Obsidian plugin - WASM tree-sitter code parser",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=cjs --platform=browser --external:obsidian --outfile=main.js && node scripts/copy-wasm.js"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "blakejs": "1.2.1",
    "web-tree-sitter": "0.27.2"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "obsidian": "1.7.2"
  }
}
