{
  "name": "astrolabe-desktop-node",
  "version": "0.1.0",
  "private": true,
  "description": "Astrolabe 个人版 · Node 全栈（Electron + SQLite + React）",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@types/d3-force": "^3.0.10",
    "@types/turndown": "^5.0.6",
    "better-sqlite3": "^11.8.1",
    "d3-force": "^3.0.1",
    "lucide-react": "^1.43.0",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "react-simple-code-editor": "^0.14.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.25.0",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "app.astrolabe.node",
    "productName": "Astrolabe",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "backend/**/*",
      "shared/**/*",
      "ui/dist/**/*"
    ]
  }
}
